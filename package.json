{
  "name": "axle-workspace",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "start": "pnpm exec tsx --tsconfig packages/axle-cli/tsconfig.json packages/axle-cli/src/cli.ts",
    "build": "pnpm -r --filter @fifthrevision/axle --filter @fifthrevision/axle-cli build",
    "build-dev": "pnpm -r --filter @fifthrevision/axle --filter @fifthrevision/axle-cli build-dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "changelog": "pnpm start -j ./jobs/changelog.job.yml --args",
    "release": "node scripts/release.mjs",
    "cut-release": "node scripts/cut-release.mjs",
    "checks": "pnpm exec tsx checks/run.ts",
    "cli:install": "pnpm --filter axle-cli run package:install"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
