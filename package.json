{
  "name": "axle-workspace",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "prepare": "pnpm run build",
    "start": "pnpm --filter @fifthrevision/axle build-dev && pnpm exec tsx packages/axle-cli/src/cli.ts",
    "build": "pnpm -r --filter @fifthrevision/axle --filter @fifthrevision/axle-cli build",
    "build:watch": "pnpm --filter @fifthrevision/axle build:watch",
    "build-dev": "pnpm -r --filter @fifthrevision/axle --filter @fifthrevision/axle-cli build-dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "changelog": "pnpm start -j ./jobs/changelog.job.yml --args",
    "generate:job-schema": "pnpm --filter @fifthrevision/axle-cli run generate:job-schema",
    "update-models": "pnpm exec tsx scripts/getModelsDev.ts",
    "release": "node scripts/release.mjs",
    "cut-release": "node scripts/cut-release.mjs",
    "checks": "pnpm exec tsx checks/run.ts",
    "checks:extended": "pnpm exec tsx checks/run.ts --extended"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@fifthrevision/axle": "workspace:*",
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "log-update": "^8.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "zod": "^4.6.2"
  }
}
