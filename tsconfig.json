{
  "compilerOptions": {
    "target": "es2024",
    "module": "node16",
    "moduleResolution": "node16",
    "paths": {
      "@fifthrevision/axle": ["./packages/axle/src/index.ts"],
      "@fifthrevision/axle/ui": ["./packages/axle/src/ui.ts"]
    },
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "exclude": ["**/dist/**", "node_modules"]
}
