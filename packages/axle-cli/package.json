{
  "name": "@fifthrevision/axle-cli",
  "version": "0.30.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncch/axle.git"
  },
  "description": "Axle command line workflow runner.",
  "type": "module",
  "bin": {
    "axle": "dist/cli.js"
  },
  "exports": {
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsx ./src/cli.ts",
    "generate:job-schema": "tsx ./scripts/generate-job-schema.ts",
    "build": "tsdown --clean --minify",
    "build:watch": "tsdown --watch",
    "build-dev": "tsdown"
  },
  "author": "Chong Han Chua",
  "license": "ISC",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@commander-js/extra-typings": "^15.0.0",
    "@fifthrevision/axle": "workspace:*",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/react": "^19.2.18",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
