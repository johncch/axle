{
  "name": "@fifthrevision/axle-cli",
  "version": "0.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncch/axle.git"
  },
  "description": "Axle command line workflow runner.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "axle": "dist/cli.js"
  },
  "exports": {
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsx ./src/cli.ts",
    "generate:schemas": "tsx ./scripts/generate-schemas.ts",
    "build": "tsdown --clean --minify",
    "build:watch": "tsdown --watch",
    "package": "pnpm build && bun scripts/build-binary.mjs",
    "package:install": "pnpm build && bun scripts/build-binary.mjs --install ~/bin",
    "build-dev": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "author": "Chong Han Chua",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@clack/core": "^1.5.1",
    "@commander-js/extra-typings": "^15.0.0",
    "@fifthrevision/axle": "workspace:*",
    "@google/genai": "^2.27.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.5",
    "glob": "^13.0.6",
    "ink": "^8.0.0",
    "marked": "^18.1.0",
    "mime": "^4.1.0",
    "openai": "^7.28.0",
    "react": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/react": "^19.3.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
