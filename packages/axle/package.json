{
  "name": "@fifthrevision/axle",
  "version": "0.32.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncch/axle.git"
  },
  "description": "Axle core runtime for building agentic LLM applications.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --clean --minify",
    "build:watch": "tsdown --watch",
    "build-dev": "tsdown"
  },
  "author": "Chong Han Chua",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^6.0.0",
    "glob": "^13.0.6",
    "marked": "^18.0.12",
    "mime": "^4.1.0",
    "openai": "^7.15.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
