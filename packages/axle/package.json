{
  "name": "@fifthrevision/axle",
  "version": "0.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncch/axle.git"
  },
  "description": "Axle core runtime for building agentic LLM applications.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "import": "./dist/ui.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --clean --minify",
    "build:watch": "tsdown --watch",
    "build-dev": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "author": "Chong Han Chua",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/genai": "^2.24.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chalk": "^6.0.1",
    "glob": "^13.0.6",
    "marked": "^18.0.14",
    "mime": "^4.1.0",
    "openai": "^7.25.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "commander": "^15.0.0",
    "dotenv": "^18.0.5",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
